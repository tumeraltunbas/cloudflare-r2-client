{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"main": "electron/main.js",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:4173 && electron .\"",
		"dist:mac": "vite build && electron-builder --mac",
		"dist:win": "vite build && electron-builder --win"
	},
	"build": {
		"appId": "com.tumeraltunbas.cloudflareR2client",
		"productName": "Cloudflare R2 Client",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"electron/**/*",
			"package.json"
		],
		"extraResources": [
			{
				"from": "../backend/dist",
				"to": "backend/dist"
			},
			{
				"from": "../backend/node_modules",
				"to": "backend/node_modules"
			},
			{
				"from": "../backend/package.json",
				"to": "backend/package.json"
			}
		],
		"toolsets": {
			"nsis": "1.2.1"
		},
		"mac": {
			"icon": "build/cloudflare.icns",
			"target": "dmg"
		},
		"win": {
			"icon": "build/cloudflare.ico",
			"target": "nsis"
		}
	},
	"dependencies": {
		"@ant-design/icons": "^6.3.2",
		"@tanstack/react-query": "^5.101.4",
		"@types/react-router": "^5.1.20",
		"antd": "^6.5.1",
		"concurrently": "^10.0.6",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "^7.18.1",
		"sonner": "^2.0.7",
		"wait-on": "^9.5.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.13.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"autoprefixer": "^10.5.3",
		"electron": "^45.2.1",
		"electron-builder": "^26.18.0",
		"eslint": "^10.6.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"globals": "^17.7.0",
		"postcss": "^8.5.19",
		"tailwindcss": "^3.4.19",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.62.0",
		"vite": "^8.1.1"
	}
}
